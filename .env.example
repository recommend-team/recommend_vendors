# Copy to .env for development. Everything prefixed VITE_ is baked into the bundle at
# build time and is PUBLIC — never put a secret here.

# Backend REST base, including the version prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional — the support number shown to a suspended vendor. Unset uses the default
# (+234 814 306 7676). Keep in step with the backend's SUPPORT_PHONE.
VITE_SUPPORT_PHONE=+234 814 306 7676
